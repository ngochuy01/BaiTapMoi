<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CHI TIẾT CÔNG VIỆC"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <!-- Hiển thị mã công việc (Yêu cầu 2) -->
    <TextView
        android:id="@+id/tvChiTietMa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/tvChiTietTen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <TextView
        android:id="@+id/tvChiTietMoTa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:paddingBottom="8dp"/>

    <!-- Hiển thị trạng thái (Yêu cầu 5) -->
    <TextView
        android:id="@+id/tvChiTietTrangThai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="italic"
        android:paddingBottom="16dp"/>

    <!-- Nút Hoàn thành (Yêu cầu 3) -->
    <Button
        android:id="@+id/btnHoanThanh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đánh dấu Hoàn thành"
        android:backgroundTint="@android:color/holo_green_dark"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chỉnh sửa công việc"/>

</LinearLayout>